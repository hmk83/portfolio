    padding:6px 8px;
    font-size:10px;
    color:#444 !important;
    text-decoration:none;
    background:#fff;
    white-space:nowrap;
  }

  .je-lang-options a:hover{
    background:#f4f4f4;
    color:#111;
  }

  /* ✅ 장바구니 버튼 (높이 동일 & hover 삭제) */
  .je-cart-btn{
    right:84px;
    width:28px;
    height:28px;
    display:inline-flex;
    align-items:center;
    justify-content:center;
    border:1px solid #bbb;
    border-radius:4px;
    background:#fff;
    text-decoration:none;
    color:#555;
  }

  /* ✅ 완전 Hover 삭제 (아무 변화 없음) */
  .je-cart-btn:hover{
    background:#fff;
    border-color:#bbb;
    color:#555;
  }

  .je-cart-btn svg{
    width:16px; height:16px;
    display:block;
  }
}

/* 모바일 숨김 */
@media (max-width:1024px){
  .je-lang-wrap,
  .je-cart-btn{ display:none !important; }
}
