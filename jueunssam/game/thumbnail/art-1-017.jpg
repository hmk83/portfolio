}






/* #menu-item-5439은 과장님 사이트의 '로그인' 메뉴 번호입니다 */

#menu-item-5439 .menu-link {
    background-color: #FEE500 !important; /* 카카오 노란색 */
    color: #3C1E1E !important; /* 카카오 갈색 */
    border-radius: 50px !important; /* 둥근 모양 */
    padding: 12px 28px !important; /* 크기 조절 */
    
    /* 높이 및 정렬 설정 */
    line-height: 1 !important; 
    height: auto !important; 
    display: inline-flex !important;
    align-items: center !important;
    justify-content: center !important;
    border: none !important;
}

/* 메뉴 위치 중앙 정렬 */
#menu-item-5266 {
    display: flex !important;
    align-items: center !important;
}

/* 마우스 올렸을 때 효과 */
#menu-item-5266 .menu-link:hover {
    background-color: #E6D200 !important;
    color: #3C1E1E !important;
    opacity: 1 !important;
}




/* =========================================
   1. [메인 메뉴] 마우스 올리면 글씨 굵게
   ========================================= */
header .menu-item > a {
    transition: font-weight 0.1s ease;
    padding-left: 10px !important;  /* 메뉴 좌우 간격 유지 */
    padding-right: 10px !important;
}

header .menu-item > a:hover {
    font-weight: 900 !important; /* 굵게 강조 */
    color: #000000 !important;
}

/* =========================================
   2. [드롭박스] 여유로운 버튼 스타일
   ========================================= */
/* 드롭박스 메뉴 항목 (평상시) */
header .sub-menu .menu-item a {
    /* [핵심 수정] 내부 여백을 늘려 글자 주변을 시원하게 만듦 */
    padding: 12px 24px !important; /* 상하 12px, 좌우 24px (기존보다 넓음) */
    
    /* [추가] 버튼 배경이 박스 끝에 닿지 않게 살짝 띄움 */
    margin: 4px 8px !important; 
    
    display: block !important;
    border-radius: 8px !important; /* 모서리 둥글게 */
    transition: all 0.2s ease;
}

/* 드롭박스 마우스 올렸을 때 (배경색 + 볼드) */
header .sub-menu .menu-item a:hover {
    font-weight: 700 !important; /* 볼드 효과 */
    background-color: #f5f5f5 !important; /* 연한 회색 배경 */
    color: #333333 !important;
}


/* 1. 이메일(아이디) 행 전체와 필수 표시(*) 완벽 숨김 */
label[for="req"],
label[for="req-text"] + .div_text {
    display: none !important;
}


/* 1. 이메일(아이디) 행 전체와 필수 표시(*) 완벽 숨김 */
label[for="user_email"],
label[for="user_email"] + .div_text {
    display: none !important;
}

/* 2. 이름 필드 수정 불가 스타일 적용 */
#display_name {
    background-color: #eee !important; /* 회색 배경으로 변경 */
    cursor: not-allowed; /* 마우스 커서를 금지 모양으로 */
    pointer-events: none; /* 클릭 및 선택 방지 */
}

/* 1. 입력창과 중복확인 버튼 레이아웃 분리 (잘림 방지 핵심) */
.add-buttons {
    display: flex !important;
    align-items: stretch !important; /* 입력창과 버튼 높이를 동일하게 */
    gap: 10px !important; /* 입력창과 버튼 사이 간격 */
    height: auto !important;
}

/* 2. 입력창 스타일 조정 (버튼과 겹치지 않게) */
.add-buttons input {
    flex: 1 !important; /* 남은 공간 모두 차지 */
    margin: 0 !important;
    height: 48px !important; /* 높이 명시 */
}

/* 3. 중복확인 버튼 래퍼 및 버튼 스타일 */
.add-buttons-wrap {
    position: static !important; /* 입력창 내부 절대좌표 해제 */
    display: flex !important;
}

.add-buttons-wrap button {
    height: 48px !important; /* 입력창과 동일한 높이 */
    min-width: 90px !important;
    padding: 0 15px !important;
    background-color: #FEE500 !important;
    color: #191919 !important;
    border: 1px solid #FEE500 !important;
    border-radius: 8px !important;
    font-size: 14px !important;
    font-weight: 700 !important;
    white-space: nowrap !important; /* 텍스트 줄바꿈 방지 */
    cursor: pointer !important;
    transition: all 0.2s !important;
    box-sizing: border-box !important;
}

/* 4. 프로필 업데이트 메인 버튼 (텍스트 잘림 해결) */
.button_div .buttons, 
input[name="submit"].buttons {
    display: block !important;
    width: 100% !important;
    height: 60px !important; /* 높이를 충분히 확보 */
    line-height: 60px !important; /* 수직 중앙 정렬 강제 */
    padding: 0 !important; /* 패딩 대신 line-height로 정렬 */
    
    background-color: #FEE500 !important;
    color: #191919 !important;
    border: none !important;
    border-radius: 12px !important;
    
    font-size: 18px !important;
    font-weight: 800 !important;
    text-align: center !important;
    
    box-shadow: 0 4px 0px #E1C900 !important;
    margin-top: 30px !important;
    cursor: pointer !important;
    -webkit-appearance: none;
}

/* 호버 효과 */
.add-buttons-wrap button:hover {
    background-color: #191919 !important;
    color: #FEE500 !important;
    border-color: #191919 !important;
}

.button_div .buttons:hover {
    background-color: #FADA0A !important;
    transform: translateY(2px) !important;
    box-shadow: 0 2px 0px #E1C900 !important;
}








/* 1. 서브 메뉴 전체 배경을 흰색으로 변경 */
.main-header-menu .sub-menu,
#menu-item-5248 .sub-menu {
    background-color: #ffffff !important; /* 배경 흰색 */
    border: 1px solid #e2e2e2 !important; /* 연한 테두리 추가 */
    box-shadow: 0 4px 10px rgba(0, 0, 0, 0.1) !important; /* 부드러운 그림자 추가 */
    padding: 10px 0 !important;
}

/* 2. 서브 메뉴 내부의 링크 텍스트 색상 및 간격 */
.main-header-menu .sub-menu .menu-link,
#menu-item-5248 .sub-menu .menu-link {
    color: #333333 !important; /* 글자색 진한 회색 */
    padding: 12px 20px !important;
    display: block !important;
    transition: all 0.2s ease;
}

/* 3. 마우스 올렸을 때(Hover) 효과 */
.main-header-menu .sub-menu .menu-item:hover > .menu-link {
    background-color: #f8f8f8 !important; /* 배경 살짝 어둡게 */
    color: #000000 !important; /* 글자색 검정 */
}

/* 4. 메뉴 내 아이콘(화살표) 스타일 조정 */
.sub-menu .ast-icon svg {
    fill: #333333 !important; /* 아이콘 색상 변경 */
    margin-right: 8px;
}


/* 아이프레임 내부 혹은 부모에서 스크롤바를 감춤 */
.container::-webkit-scrollbar {
    display: none; /* Chrome, Safari */
}
.container {
    -ms-overflow-style: none; /* IE and Edge */
    scrollbar-width: none; /* Firefox */
}		</style>
