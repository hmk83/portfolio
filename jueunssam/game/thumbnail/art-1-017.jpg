  }

  .je-lang-current{ display:inline-flex; align-items:center; gap:6px; }
  .je-lang-caret{ font-size:9px; opacity:.7; }

  .je-lang-options{
    display:none;
    position:absolute;
    top:100%;
    right:0;
    margin-top:4px;
    background:#fff;
    border:1px solid #ddd;
    border-radius:4px;
    overflow:hidden;
    min-width:100%;
    z-index:999;
  }

  .je-lang-options a{
