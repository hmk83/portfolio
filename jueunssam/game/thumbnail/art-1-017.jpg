			<style class="wpcode-css-snippet">/* 1. 화면 전체 정중앙 배치 */
.jueun-page-wrapper {
    display: flex;
    justify-content: center;
    align-items: center;
    min-height: 85vh;
    padding: 20px;
    box-sizing: border-box;
}

/* 2. 컨테이너 디자인 */
.jueun-form-container {
    width: 100%;
    max-width: 400px;
    padding: 50px 30px;
    background: #ffffff;
    border-radius: 20px;
    box-shadow: 0 10px 40px rgba(0,0,0,0.06);
    text-align: center;
}

/* 3. 로고 스타일 */
.jueun-logo img {
    max-width: 180px; /* 로고 크기 조정 */
    margin-bottom: 35px;
    height: auto;
}

/* 4. 문구 스타일 */
.jueun-logged-in-msg {
    font-size: 13px;
    color: #999;
    margin-bottom: 25px;
}

.form-desc {
    font-size: 15px;
    color: #333;
    margin-bottom: 25px;
    line-height: 1.6;
    word-break: keep-all;
}

/* 5. 입력창 디자인 */
#user_login {
    width: 100%;
    padding: 16px;
    border: 1px solid #ebebeb;
    border-radius: 12px;
    margin-bottom: 12px;
    font-size: 15px;
    background: #fdfdfd;
    box-sizing: border-box;
}

/* 6. 카카오톡 컬러 버튼 적용 */
.jueun-submit-btn {
    width: 100%;
    padding: 16px;
    background: #FEE500; /* 카카오 노란색 */
    color: #191919; /* 카카오 다크브라운 텍스트 */
    border: none;
    border-radius: 12px;
    font-weight: bold;
    font-size: 16px;
    cursor: pointer;
    transition: all 0.2s ease;
}

.jueun-submit-btn:hover {
    background: #fada00; /* 호버 시 약간 진한 노란색 */
    transform: translateY(-1px);
}

/* 7. 뒤로가기 버튼 */
.jueun-cancel-btn {
    display: inline-block;
    margin-top: 25px;
    color: #aaaaaa;
    text-decoration: none;
    font-size: 14px;
    border-bottom: 1px solid #eee;
    padding-bottom: 2px;
}

.jueun-cancel-btn:hover {
    color: #666;
    border-bottom-color: #999;
